<div class="shopkeeper-edit">
  <div class="shopkeeper-edit-sidebar">
    <button type="button" class="shopkeeper-new-shop-btn" data-action="newShop">
      <i class="fa-solid fa-plus"></i> {{localize "SHOPKEEPER.Edit.NewShop"}}
    </button>
    <button type="button" class="shopkeeper-theme-btn{{#if showingThemes}} active{{/if}}" data-action="showThemes">
      <i class="fa-solid fa-palette"></i> {{localize "SHOPKEEPER.Themes.Button"}}
    </button>

    <div class="shopkeeper-edit-shop-list">
      {{#each shops as |shop|}}
        <div class="shopkeeper-edit-shop-item{{#if (and (eq shop.id ../selectedShopId) (not ../showingThemes))}} active{{/if}}"
             data-shop-id="{{shop.id}}" data-action="selectShop">
          <img src="{{shop.img}}" alt="">
          <span class="shopkeeper-edit-shop-item-name">{{shop.name}}</span>
          {{#unless shop.visible}}<i class="fa-solid fa-eye-slash shopkeeper-hidden-icon" title="{{localize 'SHOPKEEPER.Market.HiddenFromPlayers'}}"></i>{{/unless}}
          <button type="button" class="shopkeeper-edit-shop-delete" data-action="deleteShop" title="{{localize 'SHOPKEEPER.Edit.DeleteShop'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="shopkeeper-edit-main">

    {{#if showingThemes}}
      {{!-- ============ THEME GALLERY ============ --}}
      <div class="shopkeeper-theme-gallery">
        <div class="shopkeeper-theme-header">
          <div>
            <h3>{{localize "SHOPKEEPER.Themes.Heading"}}</h3>
            <p class="shopkeeper-theme-sub">{{localize "SHOPKEEPER.Themes.Subheading"}}</p>
          </div>
          <button type="button" class="shopkeeper-back-btn" data-action="showShops">
            <i class="fa-solid fa-arrow-left"></i> {{localize "SHOPKEEPER.Themes.BackToShops"}}
          </button>
        </div>

        {{#each themes as |theme|}}
          <div class="shopkeeper-theme-option{{#if theme.active}} active{{/if}}"
               data-theme-id="{{theme.id}}" data-action="pickTheme"
               role="button" tabindex="0">
            <div class="shopkeeper-theme-meta">
              <span class="shopkeeper-theme-check">
                <i class="fa-solid {{#if theme.active}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
              </span>
              <span class="shopkeeper-theme-label">{{theme.label}}</span>
              {{#if theme.usesAccent}}
                <span class="shopkeeper-theme-tag" title="{{localize 'SHOPKEEPER.Themes.UsesAccentHint'}}">
                  <i class="fa-solid fa-droplet"></i> {{localize "SHOPKEEPER.Themes.UsesAccent"}}
                </span>
              {{/if}}
              {{#if theme.animated}}
                <span class="shopkeeper-theme-tag" title="{{localize 'SHOPKEEPER.Themes.AnimatedHint'}}">
                  <i class="fa-solid fa-wind"></i> {{localize "SHOPKEEPER.Themes.Animated"}}
                </span>
              {{/if}}
              <span class="shopkeeper-theme-hint">{{theme.hint}}</span>
            </div>

            <div class="shopkeeper-theme-preview sk-theme-{{theme.id}}">
              <div class="sk-row"
                   data-shop-img="{{theme.sampleImg}}"
                   data-shop-accent="{{theme.sampleAccent}}"
                   data-shop-framing="{{theme.sampleFraming}}">
                <div class="sk-bg" aria-hidden="true"></div>
                <div class="sk-art"><span class="sk-thumb"><img src="{{theme.sampleImg}}" alt=""></span></div>
                <div class="sk-text">
                  <div class="sk-name">{{theme.sampleName}}</div>
                  <div class="sk-desc">{{theme.sampleDesc}}</div>
                </div>
                <div class="sk-sigil" aria-hidden="true">{{theme.sampleSigil}}</div>
                <div class="sk-stamp" aria-hidden="true"></div>
                <div class="sk-chev" aria-hidden="true">&#10095;</div>
              </div>
            </div>
          </div>
        {{/each}}
      </div>

    {{else if draft}}
      {{!-- ============ SHOP EDITOR ============ --}}
      <div class="shopkeeper-edit-form">
        <div class="shopkeeper-edit-top-row">
          <div class="shopkeeper-edit-image-block">
            {{!-- Mirrors the shop framing; edited in the Image Framing panel below. --}}
            <div class="shopkeeper-frame-box shopkeeper-frame-square" data-frame-preview="shop">
              <img src="{{draft.img}}" alt="">
            </div>
            <button type="button" data-action="browseImage">{{localize "SHOPKEEPER.Edit.ShopImage"}}</button>
          </div>
          <div class="shopkeeper-edit-fields">
            <label>
              {{localize "SHOPKEEPER.Edit.ShopName"}}
              <input type="text" name="shop-name" value="{{draft.name}}">
            </label>
            <div class="shopkeeper-edit-inline-row">
              <label class="shopkeeper-visible-toggle">
                <input type="checkbox" name="shop-visible" {{#if draft.visible}}checked{{/if}}>
                {{localize "SHOPKEEPER.Edit.Visible"}}
              </label>
              <label class="shopkeeper-accent-field">
                {{localize "SHOPKEEPER.Edit.Accent"}}
                <input type="color" name="shop-accent" value="{{draft.accent}}">
                <span class="shopkeeper-accent-note">{{localize "SHOPKEEPER.Edit.AccentNote"}}</span>
              </label>
            </div>
            <label>
              {{localize "SHOPKEEPER.Edit.ShopDescription"}}
              <textarea name="shop-description" rows="3">{{draft.description}}</textarea>
            </label>
          </div>
        </div>

        {{!-- ============ IMAGE FRAMING ============ --}}
        <details class="shopkeeper-framing" data-sync="shopkeeper-framing" {{#if framingOpen}}open{{/if}}>
          <summary>
            <i class="fa-solid fa-crop-simple"></i> {{localize "SHOPKEEPER.Framing.Heading"}}
            <span class="shopkeeper-framing-hint">{{localize "SHOPKEEPER.Framing.Hint"}}</span>
          </summary>

          <div class="shopkeeper-framing-body">
            {{#each frames as |frame|}}
              <div class="shopkeeper-framing-pane" data-frame-pane="{{frame.key}}">
                <div class="shopkeeper-framing-head">
                  <span class="shopkeeper-framing-label">{{frame.label}}</span>
                  <button type="button" class="shopkeeper-framing-reset"
                          data-action="resetFraming" data-frame="{{frame.key}}"
                          title="{{localize 'SHOPKEEPER.Framing.Reset'}}">
                    <i class="fa-solid fa-rotate-left"></i>
                  </button>
                </div>
                <p class="shopkeeper-framing-sub">{{frame.hint}}</p>

                <div class="shopkeeper-frame-box {{frame.shapeClass}}" data-frame="{{frame.key}}">
                  <img src="{{../draft.img}}" alt="">
                  <span class="shopkeeper-frame-grip"><i class="fa-solid fa-up-down-left-right"></i></span>
                </div>

                <div class="shopkeeper-framing-controls">
                  <i class="fa-solid fa-magnifying-glass-minus"></i>
                  <input type="range" data-zoom-slider data-frame="{{frame.key}}"
                         min="{{../zoomMin}}" max="{{../zoomMax}}" step="{{../zoomStep}}"
                         value="{{frame.zoom}}">
                  <i class="fa-solid fa-magnifying-glass-plus"></i>
                  <span class="shopkeeper-framing-zoom" data-zoom-readout="{{frame.key}}">{{frame.zoomLabel}}</span>
                </div>
              </div>
            {{/each}}
          </div>
        </details>

        <h3>{{localize "SHOPKEEPER.Edit.Inventory"}}</h3>

        <div class="shopkeeper-tools">
          <div class="shopkeeper-tool-group">
            <label class="shopkeeper-tool-label" for="sk-table-id">{{localize "SHOPKEEPER.Tools.FromTable"}}</label>
            <select id="sk-table-id" name="table-id" {{#unless hasTables}}disabled{{/unless}}>
              {{#if hasTables}}
                {{#each tables as |table|}}
                  <option value="{{table.id}}" {{#if table.selected}}selected{{/if}}>{{table.name}}</option>
                {{/each}}
              {{else}}
                <option value="">{{localize "SHOPKEEPER.Tools.NoTablesOption"}}</option>
              {{/if}}
            </select>
            <input type="number" name="table-count" min="1" max="100" step="1"
                   value="{{tableCount}}" title="{{localize 'SHOPKEEPER.Tools.CountHint'}}"
                   {{#unless hasTables}}disabled{{/unless}}>
            <button type="button" data-action="loadFromTable" {{#unless hasTables}}disabled{{/unless}}>
              <i class="fa-solid fa-dice-d20"></i> {{localize "SHOPKEEPER.Tools.Load"}}
            </button>
          </div>

          <div class="shopkeeper-tool-group shopkeeper-tool-group-right">
            <button type="button" data-action="generatePrices" title="{{localize 'SHOPKEEPER.Tools.GeneratePricesHint'}}">
              <i class="fa-solid fa-coins"></i> {{localize "SHOPKEEPER.Tools.GeneratePrices"}}
            </button>
            <button type="button" class="shopkeeper-danger-btn" data-action="clearShop">
              <i class="fa-solid fa-broom"></i> {{localize "SHOPKEEPER.Tools.ClearShop"}}
            </button>
          </div>
        </div>

        <div class="shopkeeper-dropzone">
          <i class="fa-solid fa-hand-pointer"></i> {{localize "SHOPKEEPER.Edit.DropHint"}}
        </div>

        {{#if freeCount}}
          <p class="shopkeeper-free-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            {{localize "SHOPKEEPER.Tools.FreeWarning"}}
          </p>
        {{/if}}

        {{#if hasInventory}}
          <table class="shopkeeper-edit-inventory-table">
            <thead>
              <tr>
                <th class="col-item">{{localize "SHOPKEEPER.Shop.ColumnItem"}}</th>
                <th class="col-price">{{localize "SHOPKEEPER.Edit.Price"}}</th>
                <th class="col-qty">{{localize "SHOPKEEPER.Edit.Quantity"}}</th>
                <th class="col-unlimited" title="{{localize 'SHOPKEEPER.Edit.UnlimitedHint'}}">&infin;</th>
                <th class="col-remove"></th>
              </tr>
            </thead>
            <tbody class="shopkeeper-edit-inventory-list">
              {{#each inventory as |entry|}}
                <tr class="shopkeeper-edit-inventory-row{{#if entry.isFree}} is-free{{/if}}" data-entry-id="{{entry.id}}">
                  <td class="shopkeeper-item-name">
                    <img class="shopkeeper-item-icon" src="{{entry.img}}" alt="">
                    <span>{{entry.name}}</span>
                    {{#if entry.rarityLabel}}
                      <span class="shopkeeper-rarity shopkeeper-rarity-{{entry.rarity}}">{{entry.rarityLabel}}</span>
                    {{/if}}
                  </td>
                  <td class="col-price">
                    <input type="number" min="0" step="0.01" data-price-input value="{{entry.price}}"
                           title="{{#if entry.isFree}}{{localize 'SHOPKEEPER.Tools.FreeItemHint'}}{{/if}}">
                  </td>
                  <td class="col-qty">
                    <input type="number" min="0" step="1" data-qty-input value="{{entry.quantity}}" {{#if (lt entry.quantity 0)}}disabled{{/if}}>
                  </td>
                  <td class="col-unlimited">
                    <input type="checkbox" data-unlimited-input {{#if (lt entry.quantity 0)}}checked{{/if}}>
                  </td>
                  <td class="col-remove">
                    <button type="button" data-action="removeItem" title="{{localize 'SHOPKEEPER.Edit.RemoveItem'}}">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{/if}}

        <div class="shopkeeper-edit-save-row{{#if dirty}} is-dirty{{/if}}">
          <span class="shopkeeper-dirty-note">{{localize "SHOPKEEPER.Edit.Unsaved"}}</span>
          <button type="button" class="shopkeeper-save-btn" data-action="save">
            <i class="fa-solid fa-floppy-disk"></i> {{localize "SHOPKEEPER.Edit.Save"}}
          </button>
        </div>
      </div>

    {{else}}
      <p class="shopkeeper-empty">{{localize "SHOPKEEPER.Edit.SelectShopHint"}}</p>
    {{/if}}

  </div>
</div>
